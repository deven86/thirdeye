{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://score1000.local/schemas/stage_output.schema.json",
  "title": "StageOutput",
  "description": "Output of one of the 10 analysis stages. Score scale: 1 = strongly bearish, 50 = neutral, 100 = strongly bullish.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "product_id", "score", "direction", "confidence", "summary", "reasons", "sources", "data_as_of", "warnings"],
  "properties": {
    "stage": {"type": "integer", "minimum": 1, "maximum": 10},
    "product_id": {"type": "string", "minLength": 1},
    "score": {"type": "integer", "minimum": 1, "maximum": 100},
    "direction": {"type": "string", "enum": ["bullish", "bearish", "neutral"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "horizon_relevance": {"type": "string", "enum": ["short", "medium", "long"]},
    "summary": {"type": "string", "maxLength": 600},
    "reasons": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "impact", "evidence"],
        "properties": {
          "point": {"type": "string", "minLength": 1, "maxLength": 400},
          "impact": {"type": "integer", "minimum": -3, "maximum": 3},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^(src:[0-9]+|[A-Z0-9]{1,3}\\.[A-Za-z0-9_.]+)$"}
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "published_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^src:[0-9]+$"},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "published_at": {"type": ["string", "null"]}
        }
      }
    },
    "data_as_of": {"type": "string", "format": "date-time"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
