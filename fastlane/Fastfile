# Third Eye signing, without a Mac (same pattern as VISION).
#
# The distribution certificate and App Store profile are created once by `signing_setup`
# and stored ENCRYPTED in this repository on the `match-signing` branch (fastlane match).
# Release builds install them read-only.
#
# The encryption password is derived from the App Store Connect API key secret, so no
# extra secret is needed. If you rotate that API key, re-run "Signing setup" with force.

default_platform(:ios)

TEAM_ID = ENV.fetch("TEAM_ID")
APP_IDS = ENV.fetch("APP_IDS", "com.jondhale.thirdeye").split(",").map(&:strip)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

def run_match(readonly:, force: false)
  match(
    type: "appstore",
    api_key: asc_api_key,
    app_identifier: APP_IDS,
    team_id: TEAM_ID,
    storage_mode: "git",
    git_url: "https://github.com/#{ENV.fetch('GITHUB_REPOSITORY')}.git",
    git_branch: "match-signing",
    git_basic_authorization: ENV.fetch("MATCH_GIT_AUTH"),
    readonly: readonly,
    force: force,
    shallow_clone: true,
    skip_docs: true
  )
end

platform :ios do
  desc "One-time (and on capability changes): App ID, capabilities, distribution cert, profile"
  lane :signing_setup do
    setup_ci
    asc_api_key
    APP_IDS.each do |identifier|
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
      if bundle.nil?
        UI.message("Registering App ID #{identifier}")
        bundle = Spaceship::ConnectAPI::BundleId.create(
          name: "Third Eye #{identifier.split('.').last}", identifier: identifier, platform: "IOS"
        )
      end
      # Data Protection: app files are encrypted by iOS while the device is locked.
      begin
        bundle.update_capability(
          "DATA_PROTECTION", enabled: true,
          settings: [{ key: "DATA_PROTECTION_PERMISSION_LEVEL", options: [{ key: "COMPLETE_PROTECTION", enabled: true }] }]
        )
        UI.success("#{identifier}: Data Protection = Complete")
      rescue => e
        UI.important("#{identifier}: could not set Data Protection automatically (#{e.message})")
      end
      # iCloud (key-value storage only — no container needed) for syncing trades between iPhone and iPad.
      begin
        bundle.update_capability(
          "ICLOUD", enabled: true,
          settings: [{ key: "ICLOUD_VERSION", options: [{ key: "XCODE_6" }] }]
        )
        UI.success("#{identifier}: iCloud enabled")
      rescue => e
        UI.important("#{identifier}: could not enable iCloud automatically (#{e.message})")
      end
      # Push Notifications are added in Milestone 6, followed by a forced re-run.
    end
    run_match(readonly: false, force: ENV["MATCH_FORCE"] == "true")
  end

  desc "Enable Data Protection + iCloud on the App ID (prints the full error if Apple rejects it)"
  lane :enable_capabilities do
    asc_api_key
    APP_IDS.each do |identifier|
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
      [
        ["DATA_PROTECTION", [{ key: "DATA_PROTECTION_PERMISSION_LEVEL", options: [{ key: "COMPLETE_PROTECTION" }] }]],
        ["ICLOUD", [{ key: "ICLOUD_VERSION", options: [{ key: "XCODE_6" }] }]],
      ].each do |type, settings|
        begin
          bundle.update_capability(type, enabled: true, settings: settings)
          UI.important("PORTAL #{identifier}: enabled #{type}")
        rescue => e
          UI.important("PORTAL #{identifier}: FAILED #{type}: #{e.class}: #{e.message}")
        end
      end
      UI.important("PORTAL #{identifier}: now #{bundle.get_capabilities.map(&:capability_type).sort.join(', ')}")
    end
  end

  desc "Read-only: report the App ID's capabilities"
  lane :portal_check do
    asc_api_key
    APP_IDS.each do |identifier|
      bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
      if bundle.nil?
        UI.important("PORTAL #{identifier}: NOT REGISTERED")
        next
      end
      caps = bundle.get_capabilities.map(&:capability_type).sort
      UI.important("PORTAL #{identifier}: #{caps.join(', ')}")
    end
  end

  desc "Every release build: install existing cert + profile (never creates anything)"
  lane :signing_install do
    setup_ci
    run_match(readonly: true)
  end
end
