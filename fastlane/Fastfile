default_platform(:ios)

PROJECT = "ios/Score1000.xcodeproj"
SCHEME = "Score1000"
BUNDLE_ID = "com.devendrajondhale.score1000"

platform :ios do
  desc "Build, sign and upload to TestFlight (internal testers only)"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      readonly: ENV.fetch("MATCH_READONLY", "true") == "true",
      api_key: api_key
    )

    update_code_signing_settings(
      path: PROJECT,
      targets: [SCHEME],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{BUNDLE_ID}",
      bundle_identifier: BUNDLE_ID
    )

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%y%m%d%H%M"))
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
